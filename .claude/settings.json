{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard origin/*)",
      "Bash(vercel --prod:*)",
      "Bash(vercel deploy --prod:*)",
      "Bash(vercel rm:*)",
      "Bash(vercel project rm:*)",
      "Bash(dropdb:*)",
      "Bash(psql:*DROP DATABASE*)",
      "Bash(psql:*DROP SCHEMA*)",
      "Bash(psql:*TRUNCATE*)"
    ]
  }
}
