{
  "name": "lituk-drill",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:css": "stylelint \"src/**/*.css\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "deck:report": "tsx scripts/deck-report.ts",
    "deck:numeric": "tsx scripts/numeric-preview.ts",
    "verify": "npm run typecheck && npm run lint && npm run lint:css && npm run test",
    "hooks:install": "git config core.hooksPath .githooks",
    "deck:vocab": "tsx scripts/vocab-report.ts",
    "deck:vocab:build": "tsx scripts/handbook-vocab.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
